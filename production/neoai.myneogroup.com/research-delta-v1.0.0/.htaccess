# NEO AI — neoai.myneogroup.com
# Replaces the v17.2 neoai/.htaccess. Every directive from that file is carried
# forward in BLOCK 1 unchanged. Blocks 2 to 7 are added by the research delta.
# Generated by build/neo_research_build.py from registers/publications.json.
# Do not hand-edit: the identifier resolver in block 4 is derived.

# ============================ BLOCK 1 — v17.2, unchanged ====================
Options -Indexes

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<FilesMatch "relay\.config\.php$">
  Require all denied
</FilesMatch>

# ============================ BLOCK 2 — added: media types and caching ======
<IfModule mod_mime.c>
  AddType application/ld+json .jsonld
  AddType application/json .json
  AddType text/plain .txt
  # .xml stays application/xml here. Atom is declared in feeds/.htaccess, so a
  # sitemap is never served as application/atom+xml.
</IfModule>

<IfModule mod_expires.c>
  ExpiresByType application/json "access plus 1 hours"
  ExpiresByType application/atom+xml "access plus 1 hours"
  ExpiresByType application/pdf "access plus 30 days"
</IfModule>

# sitemap.xml, robots.txt and llms.txt must never be served stale after a
# publication. They are small and are revalidated on every request.
<FilesMatch "^(sitemap\.xml|robots\.txt|llms\.txt|capabilities\.json)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/atom+xml \
    application/ld+json image/svg+xml
</IfModule>

# ============================ BLOCK 3 — added: baseline headers =============
# Deliberately NOT a Content-Security-Policy. index.html carries an inline
# configuration script and inline styles, and a CSP added without auditing
# those would break the landing page. CSP is tracked as a separate change.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ============================ BLOCK 4 — added: identifier resolver ==========
# A canonical URL never redirects. An identifier route ALWAYS 302s, so that a
# later canonical move does not break a citation. 302 and never 301: a 301
# would be cached by the citing client and would freeze the resolution.
#
# An identifier that is registered but not published is NOT redirected. It
# returns 404. Redirecting it to the roadmap would make an unresolvable
# identifier appear to resolve, which is the failure the register exists to
# prevent.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # NEO-AI-R-009 — From Model Intelligence to System Intelligence: How Orchestration Compounds Capability
  RewriteRule ^id/NEO-AI-R-009/?$ /research/papers/model-intelligence-to-system-intelligence/ [R=302,L]
  RewriteRule ^id/NEO-AI-R-009/v1\.0/?$ /research/papers/model-intelligence-to-system-intelligence/ [R=302,L]
  RewriteRule ^pdf/NEO-AI-R-009/latest\.pdf$ /pdf/NEO-AI-R-009/v1.0.pdf [R=302,L]

  # Any other well-formed identifier: not published. 404, not a redirect.
  RewriteRule ^id/NEO-AI-[A-Z]+-[0-9]+(/.*)?$ - [R=404,L]
  RewriteRule ^id/?$ /research/ [R=302,L]

  # Trailing slash for research directories, one hop, never a chain.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/(research|search)(/.*[^/])$
  RewriteRule ^(research|search)/(.*[^/])$ /$1/$2/ [R=301,L]
</IfModule>

# ============================ BLOCK 5 — added: PDF binaries =================
# Indexed so the binary is findable, noarchive so no cache serves a stale
# version of a citable artefact, and an HTTP Link header pointing at the HTML
# canonical so the PDF never competes with the page it belongs to.
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "index, noarchive"
  </FilesMatch>
</IfModule>

<IfModule mod_setenvif.c>
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/pdf/NEO\-AI\-R\-009/v1\.0\.pdf$" NEO_PDF_NEO_AI_R_009
  Header set Link "<https://neoai.myneogroup.com/research/papers/model-intelligence-to-system-intelligence/>; rel=\"canonical\"" env=NEO_PDF_NEO_AI_R_009
</IfModule>
</IfModule>

# ============================ BLOCK 6 — added: error documents ==============
ErrorDocument 404 /404.html

# ============================ BLOCK 7 — added: canonical host ===============
# The subdomain is the canonical host for the corpus. If the legacy subpath
# https://myneogroup.com/neoai/ is still served, the 301 that retires it
# belongs in the WordPress root .htaccess, NOT here — this file is only read
# inside the subdomain document root. See DEPLOYMENT_ORDER.md, step 9.
